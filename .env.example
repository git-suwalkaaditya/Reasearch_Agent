# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
# Pick a chat model your provider currently lists - ideally one that supports tool calling and JSON mode.

# --- OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# --- Groq (free tier available)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=

# --- Google Gemini (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=

# --- Ollama (local, free; run `ollama pull <model>` first, e.g. a llama or qwen model)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=

# If your endpoint rejects JSON mode or tools, the agent degrades automatically,
# but you can also switch them off explicitly:
# LLM_JSON_MODE=false
# LLM_TOOL_CALLING=false

# --- Retrieval
EMBEDDING_BACKEND=auto          # auto | sentence-transformers | openai | lsa
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_BACKEND=auto           # auto | cross-encoder | llm | none

# --- Search
SEARCH_SOURCES=arxiv,semantic_scholar
SEMANTIC_SCHOLAR_API_KEY=       # optional, raises rate limits

# --- Budget
MAX_ITERATIONS=2
MAX_PAPERS=8
PAPERS_PER_ITERATION=5
